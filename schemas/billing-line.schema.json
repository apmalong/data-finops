{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BillingLine",
  "description": "Interim fixture shape. Superseded at M1 by the pinned FOCUS release schema plus documented x_ extensions (ADR 0015); do not extend this shape.",
  "type": "object",
  "required": [
    "provider",
    "source_record_id",
    "source_version",
    "service",
    "usage_start",
    "usage_end",
    "currency",
    "billed_cost",
    "cost_basis"
  ],
  "properties": {
    "provider": {
      "enum": [
        "aws",
        "gcp",
        "snowflake",
        "other"
      ]
    },
    "source_record_id": {
      "type": "string"
    },
    "source_version": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "usage_start": {
      "type": "string",
      "format": "date-time"
    },
    "usage_end": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 code."
    },
    "billed_cost": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Signed decimal as string"
    },
    "cost_basis": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
