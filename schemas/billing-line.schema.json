{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FocusChargeCategory": {
      "enum": [
        "Usage",
        "Purchase",
        "Tax",
        "Credit",
        "Adjustment"
      ],
      "title": "FocusChargeCategory",
      "type": "string"
    },
    "FocusChargeClass": {
      "enum": [
        "Correction"
      ],
      "title": "FocusChargeClass",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "BilledCost": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Billedcost",
      "type": "string"
    },
    "EffectiveCost": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Effectivecost",
      "type": "string"
    },
    "ListCost": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Listcost",
      "type": "string"
    },
    "ContractedCost": {
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Contractedcost",
      "type": "string"
    },
    "BillingAccountId": {
      "title": "Billingaccountid",
      "type": "string"
    },
    "BillingCurrency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Billingcurrency",
      "type": "string"
    },
    "BillingPeriodStart": {
      "format": "date-time",
      "title": "Billingperiodstart",
      "type": "string"
    },
    "BillingPeriodEnd": {
      "format": "date-time",
      "title": "Billingperiodend",
      "type": "string"
    },
    "ChargePeriodStart": {
      "format": "date-time",
      "title": "Chargeperiodstart",
      "type": "string"
    },
    "ChargePeriodEnd": {
      "format": "date-time",
      "title": "Chargeperiodend",
      "type": "string"
    },
    "ChargeCategory": {
      "$ref": "#/$defs/FocusChargeCategory"
    },
    "ChargeClass": {
      "anyOf": [
        {
          "$ref": "#/$defs/FocusChargeClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ProviderName": {
      "title": "Providername",
      "type": "string"
    },
    "ServiceName": {
      "title": "Servicename",
      "type": "string"
    },
    "ServiceCategory": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Servicecategory"
    },
    "SkuId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skuid"
    },
    "RegionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Regionid"
    },
    "ResourceId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resourceid"
    },
    "SubAccountId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subaccountid"
    },
    "ConsumedQuantity": {
      "anyOf": [
        {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consumedquantity"
    },
    "ConsumedUnit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consumedunit"
    },
    "PricingQuantity": {
      "anyOf": [
        {
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pricingquantity"
    },
    "PricingUnit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pricingunit"
    },
    "Tags": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tags"
    }
  },
  "required": [
    "BilledCost",
    "EffectiveCost",
    "ListCost",
    "ContractedCost",
    "BillingAccountId",
    "BillingCurrency",
    "BillingPeriodStart",
    "BillingPeriodEnd",
    "ChargePeriodStart",
    "ChargePeriodEnd",
    "ChargeCategory",
    "ProviderName",
    "ServiceName"
  ],
  "title": "BillingLine",
  "type": "object"
}
