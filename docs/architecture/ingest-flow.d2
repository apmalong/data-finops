# How each input reaches the shared SQLite file (as built through M6).
# Files arrive through `data-finops ingest <kind>`; OpenLineage events also over HTTP; and a
# Collection Run (`data-finops collect`, or a Deployment's collector) fetches all three kinds
# from AWS and hands each to the same reader.
# Render: d2 --layout elk docs/architecture/ingest-flow.d2 docs/architecture/ingest-flow.svg
direction: right

classes: {
  input: {
    shape: page
    style: {fill: "#eef2ff"; stroke: "#4338ca"}
  }
  step: {
    style: {fill: "#ffffff"; stroke: "#334155"; border-radius: 6}
  }
  outcome: {
    shape: oval
    style: {fill: "#f0fdf4"; stroke: "#15803d"; font-size: 13}
  }
  refused: {
    shape: rectangle
    style: {fill: "#fef2f2"; stroke: "#b91c1c"; font-size: 13; border-radius: 6}
  }
  table: {
    shape: cylinder
    style: {fill: "#f8fafc"; stroke: "#475569"; font-size: 13}
  }
  aside: {
    style: {fill: "#f8fafc"; stroke: "#cbd5e1"; font-color: "#475569"; border-radius: 6}
  }
}

# Billing: authoritative cost
focus: FOCUS export\nJSON Export Snapshot, or an AWS Data Exports\nDelivery by its <export>-Manifest.json {class: input}
billing: {
  label: Billing → Ledger
  read: billing.focus.load_export (JSON)\nbilling.aws_data_exports.load_delivery (Delivery):\nonly listed files, FOCUS 1.2, published_at = CreatedAt\nfrom the S3 folder (ADR 0020) · decimals exact · sha256 per file {class: step}
  import: Ledger.import_snapshot\nSnapshot Scope = account, Billing Period, source {class: step}
  new: new (current) {class: outcome}
  superseded: superseded (history) {class: outcome}
  replay: replay (nothing stored) {class: outcome}
  invalid: invalid Export Snapshot or Delivery: refused,\nnothing stored (exit 2, named by file) {class: refused}
  conflict: SnapshotConflictError\nsame ID, other content {class: refused}
  read -> import
  read -> invalid
  import -> new
  import -> superseded
  import -> replay
  import -> conflict
}
ledger_tables: Ledger tables {
  export_snapshot {class: table}
  billing_line {class: table}
}
focus -> billing.read
billing.new -> ledger_tables
billing.superseded -> ledger_tables

# OpenLineage: Workload Runs and lineage
events: OpenLineage event file\n(JSON array or JSON Lines) {class: input}
receiver: POST /api/v1/lineage\none event per request, at most 1 MiB, uncompressed\n415 if encoded · 401 without the token when one is set\n503 if the database is unusable (ADR 0024) {class: input}
lineage: {
  label: WorkloadStore.ingest_events (file) · ingest_event (one event)
  screen: lineage.validation.screen_events / screen_event\nper event, against bundled schemas\n(RunEvent 2-0-2, ParentRunFacet 1-1-0) {class: step}
  rejected: rejected by kind, never stored (HTTP 400, or 413 when too large)\n(an unparseable JSON array: whole file)\nnot UTF-8 · not JSON · too large · too deep\ninvalid RunEvent / ParentRunFacet / … {class: refused}
  unsupported: unsupported, reported (HTTP 202)\nJobEvent · DatasetEvent {class: outcome}
  clean: remove SQL query text and stack traces\neventTime to UTC · sha256 of stored JSON {class: step}
  key: key = run · event type · time + digest {class: step}
  stored: stored (HTTP 201) {class: outcome}
  duplicate: duplicate, nothing stored (HTTP 201) {class: outcome}
  changed: changed copy, kept beside\nand flagged on the run (HTTP 201) {class: outcome}
  screen -> rejected
  screen -> unsupported
  screen -> clean: valid RunEvent
  clean -> key
  key -> stored
  key -> duplicate
  key -> changed
}
workload_events: Workload store: OpenLineage {
  workload_lineage_event {class: table}
  workload_lineage_edge {class: table}
}
events -> lineage.screen
receiver -> lineage.screen
lineage.stored -> workload_events
lineage.changed -> workload_events

# dbt: Model Executions and dbt Nodes
dbt: dbt artifacts\nrun_results.json v6 · manifest.json v12 {class: input}
artifacts: {
  label: WorkloadStore.ingest_dbt_artifact
  screen: dbt.artifacts.screen_dbt_artifact\nwhole file, extra fields allowed {class: step}
  rejected: rejected with a fixed reason\ntoo large · not a dbt artifact · unsupported version\ndoes not match · no invocation_id · node repeated or misfiled {class: refused}
  key: key = invocation · kind · file sha256 {class: step}
  stored: stored {class: outcome}
  duplicate: duplicate (nothing stored) {class: outcome}
  changed: changed copy, kept beside\nand flagged {class: outcome}
  screen -> rejected
  screen -> key
  key -> stored
  key -> duplicate
  key -> changed
}
workload_dbt: Workload store: dbt {
  workload_dbt_artifact {class: table}
  workload_model_execution: workload_model_execution\n(run results) {class: table}
  workload_manifest_node: workload_manifest_node\n(manifest: no SQL, docs or macros) {class: table}
}
dbt -> artifacts.screen
artifacts.stored -> workload_dbt
artifacts.changed -> workload_dbt

# Athena: Query Executions and Identity Links
athena: Athena query history\nBatchGetQueryExecution\n+ account and region {class: input}
queries: {
  label: WorkloadStore.ingest_query_history
  screen: providers.athena.screen_query_history\nper entry, at most 512 MiB {class: step}
  refused: whole file refused, nothing stored\ntoo large · not a BatchGetQueryExecution response\naccount or region disagrees {class: refused}
  rejected: rejected by position and field,\nnever stored or echoed {class: refused}
  comment: identity.links.trusted_query_comment\nfirst line only: invocation_id, node_id {class: step}
  clean: keep allowlisted metadata + comment IDs\n(no query text) · sha256 of stored JSON {class: step}
  key: key = account · region · query ID + digest {class: step}
  stored: stored {class: outcome}
  duplicate: duplicate (nothing stored) {class: outcome}
  changed: changed copy, kept beside\nand flagged {class: outcome}
  screen -> refused
  screen -> rejected
  screen -> comment: valid entry
  comment -> clean
  clean -> key
  key -> stored
  key -> duplicate
  key -> changed
}
workload_queries: Workload store: Athena {
  workload_query_execution {class: table}
}
links: afterwards, not part of ingest:\nIdentity Links, derived from these tables when asked\n(see the domain model) {class: aside}
athena -> queries.screen
queries.stored -> workload_queries
queries.changed -> workload_queries
workload_queries -> links
workload_dbt -> links
workload_events -> links

# Collection Run (M6, spec 08): fetch from AWS, then the same readers as above
collect: data-finops collect · a Deployment's collector\nread-only AWS calls (providers.aws) {class: input}
collection: {
  label: collection.run: every source attempted, in this order
  dbt_inbox: "inbox/dbt/<invocation>/: keys not in the Watermark\na folder waits for both files; each at most 512 MiB" {class: step}
  events_inbox: inbox/openlineage/: keys not in the Watermark\neach event at most 1 MiB {class: step}
  history: Athena: page ListQueryExecutions\n(maxHistoryPages · max_history_pages)\nBatchGetQueryExecution for unseen IDs only\nQUEUED or RUNNING left for the next run {class: step}
  deliveries: Data Exports: list metadata/ for\nbillingLookbackPeriods · billing_lookback_periods\ncomplete Deliveries newer than the current snapshot, oldest first\nonly manifest-listed files: at most 2 GiB each, 8 GiB a Delivery {class: step}
  calculate: a Calculation Run for each Snapshot Scope,\non what was stored {class: step}
  summary: "one JSON summary line: stored · duplicates · rejected per source,\nwarnings, Calculation Runs; exit 0, 1 (rejected) or 2 (a source failed)" {class: outcome}
  dbt_inbox -> events_inbox -> history -> deliveries -> calculate -> summary
}
watermark: Collection Watermark {
  workload_inbox_object: workload_inbox_object\n(Inbox objects processed, by key and ETag) {class: table}
  export_delivery_collected: export_delivery_collected\n(Deliveries taken) {class: table}
  query_ids: Athena query IDs: the stored\nQuery Executions themselves {class: table}
}
collect -> collection.dbt_inbox
collection.dbt_inbox -> artifacts.screen: each file
collection.events_inbox -> lineage.screen: each file
collection.history -> queries.screen: the response
collection.deliveries -> billing.read: the downloaded Delivery
collection.dbt_inbox -> watermark.workload_inbox_object
collection.events_inbox -> watermark.workload_inbox_object
collection.deliveries -> watermark.export_delivery_collected
