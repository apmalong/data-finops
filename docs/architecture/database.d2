# Generated by scripts/database_diagram.py from the schema; do not edit by hand.
# One SQLite file; each store owns its tables (ADR 0018 and its amendment).
direction: right

ledger: Ledger (billing) {
  export_snapshot: {
    shape: sql_table
    "snapshot_id": TEXT {constraint: [primary_key]}
    "billing_account_id": TEXT {constraint: [not_null]}
    "billing_period_start": TEXT {constraint: [not_null]}
    "billing_period_end": TEXT {constraint: [not_null]}
    "source": TEXT {constraint: [not_null]}
    "content_digest": TEXT {constraint: [not_null]}
    "published_at_us": INTEGER {constraint: [not_null]}
    "snapshot_json": TEXT {constraint: [not_null]}
  }
  billing_line: {
    shape: sql_table
    "snapshot_id": TEXT {constraint: [primary_key; foreign_key]}
    "position": INTEGER {constraint: [primary_key]}
    "line_json": TEXT {constraint: [not_null]}
  }
}

