# What feeds data-finops, what it keeps, and who reads it (as built through M6).
# Render: d2 --layout elk docs/architecture/system-context.d2 docs/architecture/system-context.svg
direction: right

classes: {
  source: {
    style: {fill: "#f1f5f9"; stroke: "#64748b"; border-radius: 6}
  }
  module: {
    style: {fill: "#ffffff"; stroke: "#334155"; border-radius: 6}
  }
  store: {
    shape: cylinder
    style: {fill: "#f8fafc"; stroke: "#475569"; font-size: 13}
  }
  reader: {
    shape: person
    style: {fill: "#eef2ff"; stroke: "#4338ca"}
  }
}

aws: Customer AWS account {
  class: source
  exports: Data Exports\nFOCUS 1.2 Deliveries, Parquet in S3 {class: source}
  athena: Athena\nquery history (ListQueryExecutions,\nBatchGetQueryExecution) {class: source}
  inbox: "Inbox in a Deployment's bucket\ninbox/openlineage/ · inbox/dbt/<invocation>/ (ADR 0027)" {class: source}
}
workload: Workload (e.g. the reference workload, ADR 0021) {
  class: source
  airflow: Airflow\nOpenLineage provider {class: source}
  dbt: dbt-athena run by dbt-ol\nOpenLineage events · manifest.json · run_results.json {class: source}
}

product: data-finops (Python package: locally, or as a Deployment's two Lambda functions) {
  cli: cli\ndata-finops ingest · calculate · collect · serve · demo {class: module}
  collection: collection\nthe Collection Run: Inbox, Athena history,\nFOCUS Deliveries, then a Calculation Run\nfor each Snapshot Scope {class: module}
  aws_collectors: "providers.aws (the aws extra, boto3)\nread-only S3 and Athena calls" {class: module}
  handlers: "lambda_handlers\ncollector: the only writer (S3 If-Match)\napi: read-only, through Mangum (ADR 0026)" {class: module}

  readers: Readers: screen before anything is written {
    focus: billing.focus · billing.aws_data_exports\nFOCUS JSON, or a Delivery (Parquet) by its manifest {class: module}
    lineage: lineage\nOpenLineage events (bundled schemas) {class: module}
    dbt: dbt\nartifacts (manifest v12, run results v6) {class: module}
    athena: providers.athena\nquery history (allowlisted metadata only) {class: module}
  }

  sqlite: "One SQLite file, WAL (ADR 0018)" {
    ledger: Ledger\nExport Snapshots · Billing Lines\nAllocation Snapshots: the only cost authority {class: store}
    store: Workload store\nWorkload Runs · Model Executions · dbt Nodes\nData Assets · Lineage Edges · Query Executions {class: store}
    watermark: Collection Watermark\nDeliveries taken · Athena IDs stored · Inbox keys processed {class: store}
  }

  workload: workload\nWorkloadStore: stores screened records,\nresolves Identity Links when asked {class: module}
  identity: identity\npure link rules on explicit Evidence {class: module}
  ledger_api: ledger\nLedger.import_snapshot · store_allocations {class: module}
  calculation: calculation\nthe Calculation Run {class: module}
  engine: attribution\npure engine: Cost Pools, Coverage, Roll-ups {class: module}
  policy: providers.athena_billing\nBillable Usage, billing scope {class: module}
  reporting: reporting\nread model: Cost Summary, Cost Explanation,\nRoll-ups, reconciliation, provenance, lineage {class: module}
  api: api (optional extra)\nread API · OpenLineage receiver · dashboard\nloopback by default, optional bearer token,\nrequired off loopback (ADR 0024) {class: module}

  cli -> readers: ingest
  readers.focus -> ledger_api: an Export Snapshot
  readers.lineage -> workload: screened records
  readers.dbt -> workload: screened records
  readers.athena -> workload: screened records
  ledger_api -> sqlite.ledger
  workload -> sqlite.store
  workload -> identity
  cli -> calculation: calculate
  calculation -> ledger_api: reads the current Export Snapshot,\nstores an Allocation Snapshot
  calculation -> workload: Query Executions and their Identity Links
  calculation -> policy
  calculation -> engine
  reporting -> ledger_api: read interface
  reporting -> workload: read interface
  reporting -> engine: Roll-ups, pure sums
  api -> reporting: every read
  api -> workload: POST /api/v1/lineage, one event per request
  cli -> api: serve · demo
  cli -> collection: collect
  handlers -> collection: collector, once a day
  handlers -> api: api, read endpoints only
  collection -> aws_collectors
  collection -> readers: what they read from files
  collection -> calculation
  collection -> sqlite.watermark
}

people: FinOps and data engineers {class: reader}
scripts: scripts/\nanonymize real outputs → fixtures {class: module}
infra: "infra/pulumi/aws (its own uv project)\nPulumi components and policy pack:\none Deployment per account (spec 08)" {class: module}

aws.exports -> product.readers.focus: downloaded files
aws.athena -> product.readers.athena: response JSON
workload.dbt -> product.readers.dbt: artifact files
workload.dbt -> product.readers.lineage: event files
workload.airflow -> product.readers.lineage: event files
workload.airflow -> product.api: OpenLineage HTTP transport (local)
workload.airflow -> aws.inbox: event files (S3 PutObject)
workload.dbt -> aws.inbox: artifacts (S3 PutObject)
product.aws_collectors -> aws.exports: lists and reads Deliveries
product.aws_collectors -> aws.athena: pages history
product.aws_collectors -> aws.inbox: reads new keys
product.api -> people: dashboard and JSON
aws -> scripts: real outputs, downloaded
infra -> product.handlers: deploys
