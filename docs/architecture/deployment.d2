# The AWS Deployment: who reaches what, and across which boundary (spec 08, ADRs 0026-0028).
# Render: d2 --layout elk docs/architecture/deployment.d2 site/assets/explanation/deployment.svg
direction: right

classes: {
  part: {style: {fill: "#ffffff"; stroke: "#1f1f1c"; border-radius: 6; font-size: 20}}
  outside: {style: {fill: "#ffffff"; stroke: "#55544f"; border-radius: 6; font-size: 20; stroke-dash: 4}}
  store: {shape: cylinder; style: {fill: "#ffffff"; stroke: "#1f1f1c"; font-size: 20}}
  boundary: {style: {fill: "#f6f5f1"; stroke: "#b4532a"; font-size: 22; stroke-width: 2}}
}

producer: "Producer\nAirflow, dbt\nproducer policy" {class: outside}
reader: "Reader\nany IAM principal\nwith the reader policy" {class: outside}

account: "One AWS account" {
  class: boundary

  scheduler: "EventBridge Scheduler\nonce a day, UTC\nat most 2 retries" {class: part}
  collector: "Collector function\nthe only writer" {class: part}
  api: "API function\nread-only\nFunction URL, AWS_IAM" {class: part}

  bucket: "Deployment bucket\nprivate, TLS only\nencrypted, versioned" {
    class: boundary
    inbox: "Inbox\ninbox/openlineage/\ninbox/dbt/" {class: store}
    database: "database/\ndata-finops.sqlite" {class: store}
  }

  export: "FOCUS export bucket" {class: store}
  athena: "Athena workgroups\nquery history" {class: part}

  scheduler -> collector: "invokes"
  collector <- export: "reads Deliveries"
  collector <- athena: "lists and reads history"
  collector <- bucket.inbox: "reads new keys"
  collector -> bucket.database: "writes with If-Match"
  api <- bucket.database: "reads, cached by ETag"
}

producer -> account.bucket.inbox: "PutObject only"
reader -> account.api: "HTTPS, SigV4-signed GET"
