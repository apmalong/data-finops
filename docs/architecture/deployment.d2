# The AWS Deployment: who reaches what, and across which boundary (spec 08, ADRs 0026-0028),
# with the optional public demo (spec 09, ADRs 0029-0030).
# Render: d2 --layout elk docs/architecture/deployment.d2 site/assets/explanation/deployment.svg
direction: right

classes: {
  part: {style: {fill: "#ffffff"; stroke: "#1f1f1c"; border-radius: 6; font-size: 20}}
  outside: {style: {fill: "#ffffff"; stroke: "#55544f"; border-radius: 6; font-size: 20; stroke-dash: 4}}
  store: {shape: cylinder; style: {fill: "#ffffff"; stroke: "#1f1f1c"; font-size: 20}}
  boundary: {style: {fill: "#f6f5f1"; stroke: "#b4532a"; font-size: 22; stroke-width: 2}}
}

account: "One AWS account" {
  class: boundary

  producer: "Producer\nAirflow, dbt\nproducer policy" {class: outside}
  reader: "Reader\nan IAM principal allowed\nto invoke the read routes" {class: outside}

  deployment: "Deployment" {
    class: boundary

    scheduler: "EventBridge Scheduler\nonce a day, UTC" {class: part}
    collector: "Collector function\nthe only writer" {class: part}
    api: "API function\nread-only, behind an\nHTTP API with AWS_IAM routes" {class: part}

    bucket: "Deployment bucket\nprivate, TLS only\nencrypted, versioned" {
      class: boundary
      inbox: "Inbox\ninbox/openlineage/\ninbox/dbt/" {class: store}
      database: "database/\ndata-finops.sqlite" {class: store}
    }

    scheduler -> collector: "invokes; Lambda retries\na failed run up to twice"
    collector -> bucket.database: "writes with If-Match"
    api <- bucket.database: "reads, cached by ETag"
    collector <- bucket.inbox: "reads new keys"
  }

  demo: "Public demo (publicDemo)" {
    class: boundary

    demo_scheduler: "EventBridge Scheduler\nfour times a day, UTC" {class: part}
    simulator: "Simulator function\nthe simulated orchestrator\nno retries" {class: part}
    generator: "Generator function\ninvoked one time" {class: part}
    publisher: "Publisher function\nafter each Collection Run" {class: part}
    workgroup: "Athena workgroup\ndata-finops-demo\nscan cutoff per query" {class: part}
    cdn: "CloudFront\nHTTPS only\norigin access control" {class: part}

    demo_bucket: "Demo bucket\nprivate, TLS only, encrypted" {
      class: boundary
      dataset: "dataset/\nParquet, Glue tables" {class: store}
      site: "the site\ndashboard files\ncurrent.json, snapshots/" {class: store}
    }

    demo_scheduler -> simulator: "invokes"
    simulator -> workgroup: "real queries,\nwith query comments"
    workgroup <- demo_bucket.dataset: "scans"
    generator -> demo_bucket.dataset: "writes"
    publisher -> demo_bucket.site: "writes a snapshot,\nthen moves current.json"
    cdn <- demo_bucket.site: "reads only the site"
  }

  demo.simulator -> deployment.bucket.inbox: "OpenLineage events,\ndbt artifacts"
  deployment.bucket.database -> demo.publisher: "S3 event; reads\nonly the demo's lines"
  deployment.collector <- demo.workgroup: "lists and reads history"

  export: "FOCUS export bucket" {class: store}
  athena: "Athena workgroups\nquery history" {class: part}

  deployment.collector <- export: "reads Deliveries"
  deployment.collector <- athena: "lists and reads history"
  producer -> deployment.bucket.inbox: "PutObject only"
  reader -> deployment.api: "HTTPS, SigV4-signed GET"
}

visitor: "Visitor\nanyone, no account" {class: outside}

visitor -> account.demo.cdn: "HTTPS GET"
